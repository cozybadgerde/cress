{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cress development frontmatter",
  "description": "Parsed TOML frontmatter; normalize TOML local dates to YYYY-MM-DD strings before schema validation.",
  "type": "object",
  "properties": {
    "title": {
      "$ref": "#/$defs/nonblank"
    },
    "draft": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "published_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" },
    "excerpt": { "type": "string" },
    "list": {
      "type": "object",
      "properties": {
        "order": { "enum": ["published_at", "title"], "default": "published_at" },
        "reverse": { "type": "boolean", "default": false }
      },
      "additionalProperties": true
    },
    "type": {
      "enum": ["ordinary", "landing", "list"],
      "default": "ordinary"
    },
    "image": {
      "allOf": [
        { "$ref": "#/$defs/image" },
        {
          "properties": {
            "src": {
              "anyOf": [
                { "const": "" },
                { "$ref": "#/$defs/url" },
                { "type": "string", "pattern": "^[^/:\\s\\\\][^:\\s\\\\]*$" }
              ],
              "description": "Site-root, HTTP/HTTPS, or source-relative published asset; runtime validates syntax and resolution."
            }
          }
        }
      ]
    }
  },
  "if": {
    "properties": {
      "draft": { "const": true }
    },
    "required": ["draft"]
  },
  "else": {
    "required": ["title"]
  },
  "allOf": [
    {
      "if": { "required": ["list"] },
      "then": { "required": ["type"], "properties": { "type": { "const": "list" } } }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "not": { "pattern": "^0000-" },
      "description": "Valid Gregorian date in years 0001-9999; runtime validates calendar semantics."
    },
    "nonblank": {
      "type": "string",
      "pattern": "[^\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]"
    },
    "url": {
      "type": "string",
      "pattern": "^([hH][tT][tT][pP][sS]?://[^/?#@\\s\\\\]+[^\\s\\\\]*|/([^/\\s\\\\][^\\s\\\\]*)?)$",
      "description": "Site-root path or HTTP/HTTPS URL; runtime also validates URL syntax, ports, and dot segments."
    },
    "image": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": { "type": "string" },
        "caption": {
          "type": "string",
          "pattern": "^[^\\r\\n]*$",
          "description": "Single-line caption with text and Markdown links only; runtime validates its markup and links."
        },
        "focus": {
          "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"],
          "description": "Part of the image that themes keep visible when they crop it."
        }
      },
      "required": ["src"],
      "if": {
        "properties": {
          "src": { "type": "string", "minLength": 1 }
        },
        "required": ["src"]
      },
      "then": { "required": ["alt"] },
      "additionalProperties": true
    }
  }
}
