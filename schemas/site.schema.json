{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cress development site configuration",
  "description": "Parsed cress.toml. Runtime also validates language tags and URL semantics.",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "title": { "$ref": "frontmatter.schema.json#/$defs/nonblank" },
        "description": { "type": "string" },
        "copyright": { "type": "string" },
        "language": {
          "type": "string",
          "pattern": "^([A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*|[iIxX](-[A-Za-z0-9]{1,8})+)$",
          "default": "en",
          "description": "Runtime validates BCP 47 tags and preserves their supplied spelling."
        },
        "host": {
          "type": "string",
          "pattern": "^[hH][tT][tT][pP][sS]?://[^/?#@\\s\\\\]+/?$",
          "description": "Public HTTP/HTTPS origin; an optional final slash is removed from the prepared value."
        },
        "path": {
          "type": "string",
          "pattern": "^/([^/%\\\\?#\\s]+/)*$",
          "not": { "pattern": "(^|/)\\.{1,2}(/|$)" },
          "default": "/",
          "description": "Web URL prefix, not an output directory."
        },
        "image": {
          "allOf": [
            { "$ref": "frontmatter.schema.json#/$defs/image" },
            {
              "properties": {
                "src": {
                  "anyOf": [
                    { "const": "" },
                    { "$ref": "frontmatter.schema.json#/$defs/url" }
                  ]
                }
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "navigation": {
      "type": "object",
      "properties": {
        "main": { "$ref": "#/$defs/links" },
        "footer": { "$ref": "#/$defs/links" }
      },
      "additionalProperties": true
    },
    "syntax": {
      "type": "object",
      "properties": {
        "highlight": { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    },
    "theme": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "custom": {
          "type": "object",
          "description": "Protected open theme customization data.",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "brand": {
      "type": "object",
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "favicon": { "$ref": "frontmatter.schema.json#/$defs/url" },
        "logo": {
          "type": "object",
          "properties": {
            "src": { "$ref": "frontmatter.schema.json#/$defs/url" },
            "alt": { "type": "string" }
          },
          "required": ["src", "alt"],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "list": {
      "type": "object",
      "properties": {
        "per_page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 10,
          "description": "Entries per list page; 0 keeps every entry on one page."
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "description": "Runtime requires name when site.title is absent.",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "default": "Organization",
          "description": "schema.org type name, such as LocalBusiness or NGO."
        },
        "name": { "$ref": "frontmatter.schema.json#/$defs/nonblank" },
        "telephone": { "type": "string" },
        "email": { "type": "string", "description": "Runtime validates a plain email address." },
        "address": {
          "type": "object",
          "properties": {
            "street": { "type": "string" },
            "postal_code": { "type": "string" },
            "city": { "type": "string" },
            "region": { "type": "string" },
            "country": { "type": "string" }
          },
          "additionalProperties": true
        },
        "hours": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["mo", "tu", "we", "th", "fr", "sa", "su"] }
              },
              "opens": { "$ref": "#/$defs/time" },
              "closes": { "$ref": "#/$defs/time" }
            },
            "required": ["days", "opens", "closes"],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "$ref": "frontmatter.schema.json#/$defs/nonblank" },
          "url": { "$ref": "frontmatter.schema.json#/$defs/url" }
        },
        "required": ["label", "url"],
        "additionalProperties": true
      }
    }
  }
}
