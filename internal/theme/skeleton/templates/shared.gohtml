{{define "document-start"}}<!doctype html>
<html lang="{{.Site.Language}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}{{with .Pagination}}{{if gt .Number 1}} ({{label "page"}} {{.Number}}){{end}}{{end}}</title>
  {{if .Description}}<meta name="description" content="{{.Description}}">{{end}}
  {{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{.Canonical}}">
  <meta property="og:title" content="{{.Title}}">
  {{with .Site.Title}}<meta property="og:site_name" content="{{.}}">{{end}}
  {{with .Description}}<meta property="og:description" content="{{.}}">{{end}}
  {{with .Image}}{{if .Canonical}}<meta property="og:image" content="{{.Canonical}}">
  {{with .Alt}}<meta property="og:image:alt" content="{{.}}">{{end}}{{end}}{{end}}
  <meta name="twitter:card" content="{{if and .Image .Image.Canonical}}summary_large_image{{else}}summary{{end}}">{{end}}
  {{with .StructuredData}}<script type="application/ld+json">{{.}}</script>{{end}}
  {{with .Site.Brand.Favicon}}<link rel="icon" href="{{.}}">{{end}}
  {{with .Site.Brand.Color}}<meta name="theme-color" content="{{.}}">{{end}}
  {{block "theme-styles" .}}{{end}}
  <style>
    pre { padding: 1rem; overflow: auto; background: #f5f5f5; color: #202020; }
    {{if .Site.Syntax.Highlight}}
    pre .k, pre .kd, pre .kn, pre .kp, pre .kr, pre .kt { color: #005a9c; }
    pre .s, pre .s1, pre .s2, pre .sb, pre .sc, pre .sd { color: #7d2300; }
    pre .c, pre .c1, pre .cm, pre .cp, pre .cs { color: #525252; }
    {{end}}
    figcaption, .image-caption { font-size: .9em; }
    .captioned-image { display: inline-block; vertical-align: middle; }
    .image-caption { display: block; }
    img { max-width: 100%; height: auto; }
    .table-wrapper .align-left { text-align: left; }
    .table-wrapper .align-center { text-align: center; }
    .table-wrapper .align-right { text-align: right; }
  </style>
</head>
<body>
  {{if or .Site.Title .Site.Navigation.Main .Site.Brand.Logo}}
  <header>
    {{if .Site.Title}}<a href="{{.Site.URL}}">{{.Site.Title}}</a>{{end}}
    {{with .Site.Brand.Logo}}<img src="{{.URL}}" alt="{{.Alt}}">{{end}}
    {{with .Site.Navigation.Main}}
    <nav>
      <ul>{{range .}}<li><a href="{{.URL}}">{{.Label}}</a></li>{{end}}</ul>
    </nav>
    {{end}}
  </header>
  {{end}}
{{end}}

{{define "title-image"}}
  {{with .Image}}
  {{if .Caption}}<figure>{{end}}<img src="{{.URL}}" alt="{{.Alt}}">
  {{with .Caption}}<figcaption>{{range .}}{{if .URL}}<a href="{{.URL}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}</figcaption></figure>{{end}}
  {{end}}
{{end}}

{{define "document-end"}}
  {{if or .Site.Copyright .Site.Navigation.Footer}}
  <footer>
    {{with .Site.Navigation.Footer}}
    <ul>{{range .}}<li><a href="{{.URL}}">{{.Label}}</a></li>{{end}}</ul>
    {{end}}
    {{with .Site.Copyright}}<p>{{.}}</p>{{end}}
  </footer>
  {{end}}
</body>
</html>
{{end}}

{{define "pagination"}}{{with .Pagination}}
    <nav class="pagination" aria-label="{{label "pagination"}}">
      <ul>
        {{with .Previous}}<li><a href="{{.}}" rel="prev">{{label "previous_page"}}</a></li>{{end}}
        {{range .Pages}}<li><a href="{{.URL}}" aria-label="{{label "page"}} {{.Number}}"{{if .Current}} aria-current="page"{{end}}>{{.Number}}</a></li>{{end}}
        {{with .Next}}<li><a href="{{.}}" rel="next">{{label "next_page"}}</a></li>{{end}}
      </ul>
    </nav>
{{end}}{{end}}
