{{template "document-start" .}}
  <main id="main" class="not-found" tabindex="-1">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1>{{label "not_found_title"}}</h1>
    <p>{{label "not_found_message"}}</p>
    <p><a href="{{.Site.URL}}">{{label "home"}}</a></p>
  </main>
{{template "document-end" .}}
