{{template "document-start" .}}
  <main id="main" tabindex="-1">
    {{template "page-heading" .}}
    {{template "title-image" .}}
    <div class="prose">{{.Body}}</div>
    {{with .Entries}}
    <ul class="entries">
      {{range .}}
      <li>
        <div class="entry-heading">
          <h2><a href="{{.URL}}">{{.Title}}</a></h2>
          {{template "dates" .}}
        </div>
        {{if or .Image .Excerpt}}
        <div class="entry-content">
          {{template "entry-image" .}}
          {{with .Excerpt}}<p>{{.}}</p>{{end}}
        </div>
        {{end}}
      </li>
      {{end}}
    </ul>
    {{end}}
    {{template "pagination" .}}
  </main>
{{template "document-end" .}}
