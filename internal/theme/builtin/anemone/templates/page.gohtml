{{template "document-start" .}}
  <main id="main" tabindex="-1">
    <article>
      <header class="page-heading">
        <h1>{{.Title}}</h1>
        {{template "dates" .}}
      </header>
      {{template "title-image" .}}
      <div class="prose">{{.Body}}</div>
    </article>
  </main>
{{template "document-end" .}}
